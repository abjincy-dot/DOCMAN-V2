<?xml version="1.0" encoding="utf-8"?>
<!--
    FILE LOCATION:
    android/app/src/main/res/drawable/bg_pdf_toolbar_pill.xml

    Groups the top toolbar's Mark/Bookmark/Rotate icons into one visually
    distinct cluster, separate from Back + the filename. Flat, solid fill
    (unlike bg_pdf_search_pill's gradient) so it stays subtle at this small
    a size instead of competing with the icons themselves.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#FF232849" />
    <corners android:radius="999dp" />
    <stroke android:width="1dp" android:color="#26FFFFFF" />
</shape>
