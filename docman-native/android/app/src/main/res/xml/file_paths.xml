<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Files are only ever staged in the app cache dir before being
         shared (see nativeDownload() / exportPdf() in app.js), so that's
         the only path the FileProvider needs to expose. Previously this
         also granted access to the entire external storage root via an
         unused external-path entry — removed. -->
    <cache-path name="my_cache_images" path="." />
</paths>