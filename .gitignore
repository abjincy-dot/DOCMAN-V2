# Dependencies
node_modules/

# Android build output (also covered by docman-native/android/.gitignore
# for anything under android/, this catches it everywhere else too)
build/
.gradle/
*.apk
*.aab
*.aar

# Local machine config
local.properties
.idea/

# Signing secrets -- never commit
keystore.properties
*.jks
*.keystore
*.p12

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Generated by "npx cap copy" -- a byte-for-byte duplicate of docman-native/www,
# which is already tracked. Committing it doubles the web layer in every diff.
docman-native/android/app/src/main/assets/public/
docman-native/android/app/src/main/assets/capacitor.config.json
